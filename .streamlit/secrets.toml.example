# MediCompass AI - Streamlit Secrets Example Configuration
# Rename this file to secrets.toml in local development or paste into Streamlit Cloud Secrets.

# 1. Groq API Key (Required for live AI inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# 2. Groq LLM Model Selection (Optional, defaults to llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL = "llama-3.3-70b-versatile"

# 3. Google Drive Public Folder URLs (Optional for MVP automated document sync)
# Add public Google Drive folder links separated by newlines
GOOGLE_DRIVE_FOLDER_URLS = """
# https://drive.google.com/drive/folders/YOUR_BIOLOGY_PUBLIC_FOLDER_ID
# https://drive.google.com/drive/folders/YOUR_CHEMISTRY_PUBLIC_FOLDER_ID
# https://drive.google.com/drive/folders/YOUR_PHYSICS_PUBLIC_FOLDER_ID
"""
